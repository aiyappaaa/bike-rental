# Environment Configuration
NODE_ENV=development
PORT=5000
APP_BASE_URL=http://localhost:3000

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/rideflow-bikes
MONGODB_TEST_URI=mongodb://localhost:27017/rideflow-bikes-test

# JWT Configuration
JWT_ACCESS_SECRET=your-super-secret-access-key-at-least-32-characters-long
JWT_REFRESH_SECRET=your-super-secret-refresh-key-at-least-32-characters-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
FROM_EMAIL=noreply@rideflowbikes.com
FROM_NAME=RideFlow Bikes

# Payment Gateway Configuration (Optional)
# Razorpay
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Stripe
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# Image Storage Configuration (Optional)
# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-s3-bucket-name

# Maps Configuration (Optional)
MAPBOX_ACCESS_TOKEN=pk.your-mapbox-access-token

# Admin Configuration
ADMIN_EMAILS=admin@rideflowbikes.com,manager@rideflowbikes.com

# OAuth Configuration (Optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Feature Toggles
ENABLE_EMAIL_VERIFICATION=true
ENABLE_OTP_VERIFICATION=false
ENABLE_OAUTH=false
ENABLE_HERO_RIPPLE=true
ENABLE_ANALYTICS=false

# Analytics Configuration (Optional)
GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5

# Business Configuration (Optional - Override defaults)
BUSINESS_NAME=RideFlow Bikes
BUSINESS_LOGO=/logo.png
BUSINESS_DESCRIPTION=Premium bike rental service for urban mobility
CONTACT_EMAIL=contact@rideflowbikes.com
CONTACT_PHONE=+91-9876543210
SUPPORT_EMAIL=support@rideflowbikes.com

# Hero Section Configuration
HERO_TITLE=Ride the City, Your Way
HERO_SUBTITLE=Discover the freedom of cycling with our premium bike rental service. Eco-friendly, convenient, and affordable.
HERO_IMAGES=/hero/hero-1.jpg,/hero/hero-2.jpg,/hero/hero-3.jpg

# Operating Hours Configuration
DEFAULT_OPEN_TIME=06:00
DEFAULT_CLOSE_TIME=22:00
WEEKEND_OPEN_TIME=07:00
WEEKEND_CLOSE_TIME=21:00

# Pricing Configuration
DEFAULT_HOURLY_RATE=50
DEFAULT_DAILY_RATE=300
DEFAULT_DEPOSIT=500
GST_PERCENT=18
LATE_FEE_PER_HOUR=50
DAMAGE_DEPOSIT_PERCENT=20

# Surge Pricing Configuration
SURGE_PRICING_ENABLED=false
SURGE_PEAK_HOURS=8,9,17,18,19
SURGE_WEEKEND_MULTIPLIER=1.2
SURGE_PEAK_MULTIPLIER=1.5
SURGE_HIGH_DEMAND_MULTIPLIER=2.0

# Booking Policy Configuration
MIN_BOOKING_DURATION_HOURS=1
MAX_BOOKING_DURATION_HOURS=168
MAX_ADVANCE_BOOKING_DAYS=30
FULL_REFUND_HOURS_BEFORE=24
PARTIAL_REFUND_HOURS_BEFORE=2
PARTIAL_REFUND_PERCENT=50

# Map Configuration
MAP_DEFAULT_LAT=28.6139
MAP_DEFAULT_LNG=77.2090
MAP_DEFAULT_ZOOM=12
MAP_CLUSTER_RADIUS=50

# Social Media Links (Optional)
SOCIAL_FACEBOOK=https://facebook.com/rideflowbikes
SOCIAL_TWITTER=https://twitter.com/rideflowbikes
SOCIAL_INSTAGRAM=https://instagram.com/rideflowbikes
SOCIAL_LINKEDIN=https://linkedin.com/company/rideflowbikes

# Brand Colors (Optional)
BRAND_COLOR_PRIMARY=#3B82F6
BRAND_COLOR_SECONDARY=#10B981
BRAND_COLOR_ACCENT=#F59E0B
BRAND_COLOR_BACKGROUND=#FFFFFF
BRAND_COLOR_TEXT=#1F2937
