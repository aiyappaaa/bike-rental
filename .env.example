# Database
MONGODB_URI=mongodb://localhost:27017/rideflow-bikes
MONGODB_TEST_URI=mongodb://localhost:27017/rideflow-bikes-test

# JWT Secrets
JWT_ACCESS_SECRET=your-super-secret-access-key-here
JWT_REFRESH_SECRET=your-super-secret-refresh-key-here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# App Configuration
NODE_ENV=development
PORT=5000
APP_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
FROM_EMAIL=noreply@rideflowbikes.com
FROM_NAME=RideFlow Bikes

# Payment Gateways
# Razorpay (Primary)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Stripe (Fallback)
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Image Storage
# Cloudinary (Primary)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# AWS S3 (Fallback)
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name

# Maps
MAPBOX_ACCESS_TOKEN=pk.your_mapbox_token

# Admin Configuration
ADMIN_EMAILS=admin@rideflowbikes.com,support@rideflowbikes.com

# OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Feature Toggles
ENABLE_EMAIL_VERIFICATION=true
ENABLE_OTP_VERIFICATION=false
ENABLE_OAUTH=false
ENABLE_HERO_RIPPLE=true
ENABLE_ANALYTICS=false

# Analytics
GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5
